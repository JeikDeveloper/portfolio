# Copia este archivo como .env para desarrollo local. En Vercel se cargan en
# Settings → Environment Variables. Ninguna es obligatoria para compilar.

# --- Panel de administración en producción (Keystatic + GitHub) ---
# Keystatic las genera solo la primera vez que conectas GitHub (ver README).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Solo para la configuración inicial en local: fuerza el modo GitHub en `npm run dev`.
# PUBLIC_KEYSTATIC_STORAGE=github

# --- API de GitHub (opcional, recomendado en Vercel): repos de la página de proyectos ---
# Token "fine-grained" de solo lectura. Sin él, GitHub limita a 60 consultas por hora.
GITHUB_TOKEN=
