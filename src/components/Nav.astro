---
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './ui/Icon.astro';
import { getLangFromUrl, useTranslations, path } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const here = Astro.url.pathname;

const links = [
  { href: path(lang, 'sobre-mi'), label: t('nav.about') },
  ...(site.showProjects ? [{ href: path(lang, 'proyectos'), label: t('nav.projects') }] : []),
  { href: path(lang, 'blog'), label: t('nav.blog') },
  { href: path(lang, 'cv'), label: t('nav.cv') },
  { href: path(lang, 'contacto'), label: t('nav.contact') },
];

/** Activo si es la página o una subpágina (p. ej. un proyecto dentro de /proyectos/). */
const isActive = (href: string) => here === href || here.startsWith(href);
import { site } from '../data/site';
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={path(lang)}>
      <span class="nav__logo" aria-hidden="true">JJ</span>
      <span class="nav__name">Jeiber Jiménez</span>
    </a>

    <button
      class="icon-btn nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={t('nav.menu')}
    >
      <Icon name="menu" class="nav__icon-open" />
      <Icon name="close" class="nav__icon-close" />
    </button>

    <div class="nav__menu" id="nav-menu">
      <nav aria-label={t('nav.main')}>
        <ul class="nav__list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="nav__tools">
        <LangSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('nav-menu');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-h);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .nav__logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-s);
    background: var(--text);
    color: var(--bg);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .nav__list {
    display: flex;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__list a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .nav__list a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .nav__list a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }
  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }
  .nav__tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .nav__toggle {
    display: none;
  }
  .nav__toggle :global(.nav__icon-close) {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] :global(.nav__icon-close) {
    display: block;
  }
  .nav__toggle[aria-expanded='true'] :global(.nav__icon-open) {
    display: none;
  }

  /* Móvil: con JS el menú se pliega tras el botón; sin JS queda visible debajo. */
  @media (max-width: 63.99rem) {
    .nav__inner {
      flex-wrap: wrap;
    }
    .nav__menu {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
      padding-bottom: var(--space-m);
    }
    .nav__list {
      flex-direction: column;
    }
    .nav__list a {
      padding: 0.7rem 0.8rem;
      font-size: var(--step-0);
      border-radius: var(--radius-m);
    }
    .nav__tools {
      justify-content: space-between;
      padding-top: var(--space-m);
      border-top: 1px solid var(--border);
    }
    :global(.js) .nav__toggle {
      display: inline-grid;
    }
    :global(.js) .nav__menu:not(.is-open) {
      display: none;
    }
  }
</style>
