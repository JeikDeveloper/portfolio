---
/** Botón flotante de WhatsApp, fijo en todas las páginas. */
import Icon from './ui/Icon.astro';
import { getLangFromUrl, useTranslations, whatsappUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a class="wa-fab" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" aria-label={t('cta.whatsapp')}>
  <Icon name="whatsapp" size={22} />
</a>

<style>
  .wa-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-full);
    background: var(--text);
    color: var(--bg);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    transition: transform var(--duration) var(--ease);
  }
  .wa-fab:hover {
    transform: scale(1.06);
  }
  @media print {
    .wa-fab {
      display: none;
    }
  }
</style>
