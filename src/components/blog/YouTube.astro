---
/**
 * Video de YouTube con carga diferida: muestra la miniatura y solo carga el
 * reproductor (unos 500 KB de JavaScript) cuando la persona pulsa "reproducir".
 * Usa youtube-nocookie.com para no dejar cookies de seguimiento antes de reproducir.
 *
 * En un artículo:  <YouTube id="dsTXcSeAZq8" title="Astro in 100 Seconds" />
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  id: string;
  title?: string;
}

const { id, title = 'YouTube' } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<figure class="yt" data-yt={id}>
  <button class="yt__play" type="button" aria-label={`${t('blog.video')}: ${title}`}>
    <img src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="yt__icon" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.7C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4A8.5 8.5 0 0 0 1.5 7.7C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"></path><path d="M45 24 27 14v20" fill="#fff"></path></svg>
    </span>
  </button>
  <figcaption class="yt__caption">{title}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((fig) => {
    const btn = fig.querySelector('button');
    btn?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.yt}?autoplay=1`;
        iframe.title = fig.querySelector('figcaption')?.textContent ?? 'YouTube';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        btn.replaceWith(iframe);
        iframe.focus();
      },
      { once: true }
    );
  });
</script>

<style>
  .yt {
    margin: var(--space-xl) 0;
  }
  .yt__play,
  .yt :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: #000;
    cursor: pointer;
  }
  .yt__play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity var(--duration) var(--ease);
  }
  .yt__play:hover img {
    opacity: 1;
  }
  .yt__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .yt__caption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
</style>
