---
/**
 * Repositorios públicos y lenguajes, leídos de la API de GitHub al compilar.
 * Qué repos se muestran se configura en src/data/github.ts. Si GitHub no
 * responde, el componente no renderiza nada.
 */
import Section from './ui/Section.astro';
import Icon from './ui/Icon.astro';
import { getGitHub } from '../lib/github';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const gh = await getGitHub();

const monthYear = new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

{
  gh && gh.repos.length > 0 && (
    <Section id="github" title={t('gh.title')} note={t('gh.note')}>
      <div class="gh">
        <ul class="gh__repos">
          {gh.repos.map((repo) => (
            <li class="card card--link gh__repo" data-reveal>
              <h3 class="gh__name">
                <a href={repo.url} target="_blank" rel="noopener noreferrer">
                  {repo.name}
                </a>
              </h3>
              <p class:list={['gh__desc', { muted: !repo.description }]}>{repo.description ?? t('gh.noDescription')}</p>
              <p class="gh__meta mono">
                {repo.language && <span>{repo.language}</span>}
                {repo.stars > 0 && <span>★ {repo.stars}</span>}
                <span>{`${t('gh.updated')} ${monthYear.format(repo.pushedAt)}`}</span>
              </p>
            </li>
          ))}
        </ul>

        {gh.languages.length > 0 && (
          <aside class="gh__langs" aria-labelledby="gh-langs-title">
            <h3 class="gh__h3" id="gh-langs-title">
              {t('gh.languages')}
            </h3>
            <p class="muted gh__small">{t('gh.languagesNote')}</p>
            <ul class="gh__bars">
              {gh.languages.map((l) => (
                <li>
                  <span class="gh__lang">
                    <span>{l.name}</span>
                    <span class="muted mono">{`${l.count} ${l.count === 1 ? t('gh.repo') : t('gh.repos')}`}</span>
                  </span>
                  <span class="gh__bar" aria-hidden="true">
                    <span style={`width:${Math.round(l.share * 100)}%`} />
                  </span>
                </li>
              ))}
            </ul>
            <a class="btn btn--secondary btn--sm" href={gh.profileUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} />
              {t('gh.profile')}
            </a>
          </aside>
        )}
      </div>
    </Section>
  )
}

<style>
  .gh {
    display: grid;
    gap: var(--space-xl);
  }
  .gh__repos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }
  .gh__repo {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .gh__name {
    font-size: var(--step-0);
    font-family: var(--font-mono);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .gh__name a {
    color: inherit;
    text-decoration: none;
  }
  .gh__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .gh__desc {
    margin: 0;
    font-size: var(--step--1);
  }
  .gh__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .gh__h3 {
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }
  .gh__small {
    font-size: var(--step--1);
    margin: 0 0 var(--space-m);
  }
  .gh__bars {
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }
  .gh__lang {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    font-size: var(--step--1);
    margin-bottom: 0.35rem;
  }
  .gh__bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .gh__bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }
  @media (min-width: 40rem) {
    .gh__repos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .gh {
      grid-template-columns: 1fr 18rem;
      align-items: start;
    }
  }
</style>
