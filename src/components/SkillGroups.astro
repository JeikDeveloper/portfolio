---
/**
 * Habilidades: arriba las tecnologías principales y debajo, plegada, la lista
 * completa por categoría. Sin barras de porcentaje: los años dicen más.
 */
import Todo from './ui/Todo.astro';
import { getLangFromUrl, useTranslations, path } from '../i18n/utils';
import { skillGroups, featuredSkills, skillMonths, skillName, type Skill } from '../data/skills';
import { getProjects } from '../lib/content';
import { site } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects();
const titleOf = (slug: string) => projects.find((p) => p.id === slug)?.data[lang].title;

/** "3 años" o "menos de 1 año". Desde 10 meses se redondea al año siguiente (4 años y 10 meses -> 5 años). */
function duration(s: Skill) {
  const months = skillMonths(s);
  if (months === null) return null;
  if (months < 12) return t('skills.underYear');
  const full = Math.floor(months / 12);
  const n = months % 12 >= 10 ? full + 1 : full;
  return `${n} ${n === 1 ? t('skills.year') : t('skills.years')}`;
}
---

<ul class="top" aria-label={t('skills.main')}>
  {
    featuredSkills.map((s) => (
      <li class="top__item" data-reveal>
        {/* "AWS (Lambda, S3, …)" -> "AWS": el detalle queda en la lista completa. */}
        <span class="top__name">{skillName(s.name, lang).replace(/\s*\(.*\)$/, '')}</span>
        {duration(s) && <span class="top__years">{duration(s)}</span>}
      </li>
    ))
  }
</ul>

<details class="all">
  <summary class="all__toggle">{t('skills.all')}</summary>
<div class="grid grid--3 skills">
  {
    skillGroups.map((group) => (
      <section class="card skills__group" data-reveal aria-labelledby={`skills-${group.id}`}>
        <h3 class="skills__title" id={`skills-${group.id}`}>
          {group.title[lang]}
        </h3>
        <ul class="skills__list">
          {group.skills.map((s) => (
            <li class="skills__item">
              <span class="skills__name">{skillName(s.name, lang)}</span>
              {duration(s) && <span class="skills__years">{duration(s)}</span>}
              {/* Los proyectos donde se usó solo salen cuando la sección de proyectos está visible. */}
              {site.showProjects && s.projects && s.projects.some(titleOf) && (
                <span class="skills__used">
                  <span class="visually-hidden">{t('skills.usedIn')}: </span>
                  {s.projects.filter(titleOf).map((slug) => (
                    <a href={path(lang, 'proyectos', slug)}>{titleOf(slug)}</a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
        {group.todo && <Todo text={`[COMPLETAR] ${group.todo}`} />}
      </section>
    ))
  }
</div>
</details>

<style>
  .top {
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: var(--space-s);
  }
  .top__item {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface, transparent);
  }
  .top__name {
    font-weight: 600;
  }
  .top__years {
    font-size: var(--step--1);
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .all__toggle {
    cursor: pointer;
    width: fit-content;
    margin-bottom: var(--space-m);
    font-weight: 550;
    color: var(--text-muted);
  }
  .all__toggle:hover {
    color: var(--text);
  }
  .all[open] .all__toggle {
    margin-bottom: var(--space-l);
  }
  .skills__group {
    display: grid;
    align-content: start;
    gap: var(--space-m);
  }
  .skills__title {
    font-size: var(--step-1);
  }
  .skills__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .skills__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
    padding-block: 0.45rem;
    border-top: 1px solid var(--border);
  }
  .skills__item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .skills__name {
    font-weight: 550;
    margin-right: auto;
  }
  .skills__years {
    font-size: var(--step--1);
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .skills__used {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--step--1);
  }
  .skills__used a::before {
    content: '↳ ';
    color: var(--text-subtle);
  }
</style>
